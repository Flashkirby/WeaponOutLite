				EnableWeaponPhysics: {
					Label: Enable Item Physics
					Tooltip: Allows some held items to react to motion. Disable to prevent motion based item movement. Default is On. (Local Only)
				}

				EnableSheathingAnim: {
					Label: Enable Sheathing Animations
					Tooltip: Allows some poses to smoothly transition to an idle pose. Default is On. (Local Only)
				}

				EnableItemScaling: {
					Label: Enable Extreme Item scaling
					Tooltip: Allows items to show their size modifiers (if greater than +-10%). Disable to keep all item sizes pixel perfect. Default is On. (Local Only)
				}

				SmallSwordThreshold: {
					Label: One Handed Sword Threshold (Pixels)
					Tooltip: Maximum average of width/height to classify a Sword as one handed. Default is 50. (Local Only)
				}

				SmallGunThreshold: {
					Label: One Handed Gun Threshold (Pixels)
					Tooltip: Maximum width to classify a Gun as one handed. Default is 36. (Local Only)
				}

				GiantItemThreshold: {
					Label: Giant Item Threshold (Pixels)
					Tooltip: Maximum width or height before attempting to scale down. Default is 80. (Local Only)
				}

				GiantItemScalePercent: {
					Label: Giant Item Scaling (%)
					Tooltip: Scale down giant items to this percentage. If the item is still over the threshold, it will use one of the poses below. Default is 100%. (Local Only)
				}

				GiantItemPose: {
					Label: Giant Items
					Tooltip: Default is {$Mods.WeaponOutLite.Configs.LabelledItemPose.TwoHandCarry.Label}
				}

				GiantItemPV: {
					Label: Giant Items
					Tooltip: ""
				}

				GiantWeaponPose: {
