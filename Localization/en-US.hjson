Mods: {
	# TIL hjson supports comments
	WeaponOutLite: {
		Common: {
			Instructions: To customise item hold styles:
			Preview: Item Preview

			PoseGroup: {
				Unassigned: Unassigned
				Item: Normal Item
				LargeItem: Large Item
				VanityItem: Equippable Item
				Potion: Potion
				SmallMelee: Melee Weapon
				SmallTool: Tool
				LargeMelee: Large Melee Weapon
				LargeTool: Large Tool
				Rapier: Shortsword/Rapier
				Spear: Spear
				Yoyo: Yoyo
				Flail: Flail
				Whips: Whip
				Thrown: Throwing Weapon
				ThrownThin: Throwing Knife
				PowerTool: Power Tool
				Bow: Bow
				Repeater: Crossbow/Repeater
				Pistol: Handgun
				Gun: Automatic Gun
				GunManual: Semi-automatic Gun
				Shotgun: Shotgun
				Launcher: Launcher
				Staff: Magical Staff
				MagicBook: Spell Tome
				MagicItem: Magical Focus
				GiantItem: Giant Item
				GiantWeapon: Giant Melee Weapon
				GiantBow: Giant Bow
				GiantGun: Giant Ranged Weapon
				GiantMagic: Giant Magic Weapon
				GiantDamaging: Giant Misc Weapon
			}
		}

		Configs: {
			WeaponOutClientHoldOverride: {
				DisplayName: Item Manual Override

				StyleOverrideList: {
					Label: Style Override List
					Tooltip: ""
				}

				CurrentPoseGroup: {
					Label: Held Item Pose Group
					Tooltip: The pose group the currently held item belongs to.
				}

				CurrentDrawItemPose: {
					Label: Held Item Pose
					Tooltip: The pose the currently held item is using.
				}

				CurrentItemPosePV: {
					Label: "{$Mods.WeaponOutLite.Common.Preview}"
					Tooltip: ""
				}

				EnableWeaponQuickWeaponCategorisation: {
					Label: Enable Weapon Quick Weapon Categorisation
					Tooltip: ""
				}
			}

			WeaponOutClientConfig: {
				DisplayName: Personal Preferences

				Headers: {
					PlayerHeader: Display & Poses
					LocalGraphics: Local Graphics
					ModIntegrationHeader: Mod Integrations & Compatibility
				}

				EnableWeaponOutVisuals: {
					Label: Enable WeaponOut Visuals
					Tooltip: Enables showing held weapons, tools, items etc. Turning this off this effectively disables this mod.
				}

				ShowHeldItem: {
					Label: Show Held Item
					Tooltip: Shows the item you are holding. Other players can see this. Default is On.
				}

				CombatDelayTimerMax: {
					Label: Combat pose duration (Seconds)
					Tooltip: How long to hold an item out after using it. Only applies to poses that begin with 'Combat'. Default is 3 seconds.
				}

				CombatStanceAlwaysOn: {
					Label: Combat pose always active.
					Tooltip: Prevents combat poses from changing to idle poses. Default is Off.
				}

				CombatStanceWhenHurt: {
					Label: Combat pose activates when hurt.
					Tooltip: Enter combat pose when you are hurt by something. Default is On.
				}

				SmallItemPose: {
					Label: "[i:2]Normal Items"
					Tooltip: Default is {$Mods.WeaponOutLite.Configs.LabelledItemPose.Hold.Label}
				}

				SmallItemPosePV: {
					Label: "{$Mods.WeaponOutLite.Common.Preview}"
					Tooltip: ""
