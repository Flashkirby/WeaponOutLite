				}

				GiantDamagingPosePV: {
					Label: "{$Mods.WeaponOutLite.Common.Preview}"
					Tooltip: ""
				}

				EnableDisplayUnsyncedPlayers: {
					Label: Enable Showing Other Players
					Tooltip: "Show others player's held items, even if they don't have the mod installed. (Local Only)"
				}

				EnableMenuDisplay: {
					Label: Enable Menu Display (Experimental)
					Tooltip: Enable showing player preview with first item in the Player Select screen. Default is On. (Local Only)
				}

				EnableMeleeEffects: {
					Label: Enable Melee Effects (Experimental)
					Tooltip: Allows weapons to continue showing melee effects after being swung. Default is Off. (Local Only)
				}

				EnableProjSpears: {
					Label: Enable Full Spears (Experimental)
					Tooltip: Use spear projectile sprites. Default is On. (Local Only)
				}

				EnableProjYoyos: {
					Label: Enable Small Yoyos (Experimental)
					Tooltip: Use yoyo projectile sprites. Default is On. (Local Only)
				}

				ModIntegrationTerrariaOverhaul: {
					Label: "[i:509] Toggle: Terraria Overhaul"
					Tooltip:
						'''
						Hide item drawing when aimable weapons are selected. 
						If you want to use WeaponOut's version, turn off this toggle, and also turn off 
						'Always Show Aimable Weapons' in Terraria Overhaul under Visuals.
						'''
				}

				ModIntegrationMeleeEffectsPlus: {
					Label: "[i:509] Toggle: Melee Effects+"
					Tooltip: Applies a fix to attempt to help identify different types of swords. Default is On.
				}

				ModIntegrationVibrantReverie: {
					Label: "[i:1344] Automatic: Vibrant Reverie"
					Tooltip: Mod Call integration supported. Thanks W1K [i:58]!
				}

				ModIntegrationOverhaulGunAnimations: {
					Label: "[i:2701] Manual: Overhaul Gun Animations"
					Tooltip: Enable Overhaul Gun Animations Setting: Vanilla aim animation to remove rendering conflicts.
				}

				ModIntegrationArmamentDisplay: {
					Label: "[i:2701] Manual: ArmamentDisplay"
					Tooltip: Disable ArmamentDisplay Visual Effect Setting > Weapon display switch to remove rendering conflicts.
				}

				ModIntegrationArmamentDisplayLite: {
					Label: "[i:1344] Automatic: ArmamentDisplayLite"
					Tooltip: Disables this mod's idle poses for weapons. I can only assume this is the reason why both of these mods are installed.
				}

				ModIntegrationCoolerItemVisualEffect: {
					Label: "[i:2701] Manual: CoolerItemVisualEffect"
					Tooltip: Disable CoolerItemVisualEffect Advanced Setting > Other Settings > Weapon display switch to remove rendering conflicts.
				}

				ModIntegrationInsurgencyWeapons: {
					Label: "[i:2701] Manual: Insurgency Weapons"
					Tooltip: "Hide item drawing when insurgency weapons are selected. See also: Insurgency Server Side > Hide weapon when not in use. Default is On. "
				}

				ModIntegrationCalamityMod: {
					Label: "[i:1344] Automatic: Calamity Mod"
					Tooltip: Adds default classifications to Calamity weapons.
				}

				ModIntegrationMetroidMod: {
					Label: "[i:1344] Automatic: Metroid Mod"
					Tooltip: Adds default classifications to Arm Cannon.
				}

				ModIntegrationThoriumMod: {
					Label: "[i:1344] Automatic: Thorium Mod"
					Tooltip: Adds default classifications to Thorium weapons.
				}

				ModIntegrationRedemption: {
					Label: "[i:1344] Automatic: Mod of Redemption"
					Tooltip: Adds default classifications to Redemption weapons.
				}
			}

			WeaponOutServerConfig: {
				DisplayName: Global/Server
				Headers.ServerSide: Feature Toggles

				EnableWeaponOutVisuals: {
					Label: Enable WeaponOut Visuals
					Tooltip: Enables players to show held weapons, tools, items etc. Turning this off this will disable WeaponOut Lite for everybody. (Global Setting)
				}

				EnableForcedWeaponOutVisuals: {
					Label: Enable Forced Visuals
					Tooltip: Forces all players to show held items, regardless of clientside settings. (Global Setting)
				}
			}

